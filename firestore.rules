rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'raeesdec12@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Company settings
    match /erp_settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Staff user profiles & login roles
    match /erp_users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Trip records
    match /erp_trips/{tripId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Customer records
    match /erp_customers/{customerId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Invoice records
    match /erp_invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Financial vouchers and transactions
    match /erp_transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Consolidated enterprise cloud dataset
    match /erp_cloud_data/{documentId} {
      allow read, write: if true;
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
